// .devcontainer/devcontainer.json
{
    "name": "scroll-dev",
    "runArgs": [
        "--hostname",
        "dev"
    ],
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-docker",
                "gruntfugly.todo-tree",
                "streetsidesoftware.code-spell-checker"
            ]
        }
    },
    "forwardPorts": [
        3000,
        8080
    ] // Example ports to forward
}